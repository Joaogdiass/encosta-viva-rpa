# Copie para .env. O arquivo .env não vai para o repositório.

# Obrigatório. Salt do hash dos moradores (SHA-256). Use o mesmo valor da camada Prata.
SALT_MORADOR=troque-este-salt

# Fontes. Sem estas linhas, o robô usa os dados de demonstração de dados_demo/.
# CHEGADA_DIR=../encosta-viva-dados/chegada
# OURO_ORIGEM=../encosta-viva-dados/mvp/dados/risco_setores.json
# Também aceita URL: https://joaogdiass.github.io/encosta-viva-dados/dados/risco_setores.json

# Onde gravar o alertas.json que a tela do MVP lê. Sem esta linha, vai para saida/mvp/.
# MVP_DADOS_DIR=../encosta-viva-dados/mvp/dados

# Opcional. Pasta do repositório de Dados: gera as leituras simuladas de hoje no modo ao vivo.
# ENCOSTA_DADOS_DIR=../encosta-viva-dados

# Opcional. Sem estas duas, o canal Telegram também é simulado.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Parâmetros (valores padrão)
# LIMITE_ENVIOS_POR_MINUTO=120
# TENTATIVAS_POR_CANAL=3
# CICLOS_MAX_REENVIO=3
# JANELA_IDEMPOTENCIA_MIN=360
# SENSOR_OFFLINE_MIN=30
# BATERIA_MINIMA_PCT=20

# Só para demonstração: canais que devem falhar de propósito (ex.: telegram,sms).
# SIMULAR_FALHA_CANAIS=
