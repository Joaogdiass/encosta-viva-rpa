<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes" targetNamespace="https://encostaviva.example/rpa">
<bpmn:collaboration id="Colaboracao"><bpmn:participant id="P_robo" name="Robô de alertas Encosta Viva (software)" processRef="Robo" /><bpmn:participant id="P_moradores" name="Moradores do setor" /><bpmn:participant id="P_mvp" name="Tela do MVP (Dados)" /><bpmn:participant id="P_defesa" name="Defesa Civil: vistoria, relatório e decisão de remover moradores" /><bpmn:messageFlow id="m1" name="alerta" sourceRef="enviar" targetRef="P_moradores" /><bpmn:messageFlow id="m2" name="chamado" sourceRef="vistoria" targetRef="P_defesa" /><bpmn:messageFlow id="m3" name="PDF" sourceRef="relatorio" targetRef="P_defesa" /><bpmn:messageFlow id="m4" name="alertas.json" sourceRef="exportar" targetRef="P_mvp" /></bpmn:collaboration>
<bpmn:process id="Robo" name="Robô de alertas" isExecutable="false"><bpmn:startEvent id="inicio" name="A cada 15 min"><bpmn:outgoing>f1</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:task id="trava" name="Obter trava e abrir execução"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task><bpmn:task id="ler" name="Ler Ouro, sensores, relatos e cadastro"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_arq" name="Arquivos válidos?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="quarentena" name="Copiar para quarentena e avisar operador"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:task><bpmn:task id="validar" name="Aplicar regras de qualidade e contar descartes"><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task><bpmn:task id="hash" name="Trocar dados do morador por hash"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:task><bpmn:task id="api" name="Consultar Open-Meteo (3 tentativas com backoff)"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_api" name="API respondeu?"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="cache" name="Usar último valor com flag e avisar operador"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_junta" name=""><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f39</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:subProcess id="Setores" name="Para cada setor (repetição)"><bpmn:incoming>f39</bpmn:incoming><bpmn:outgoing>f40</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /><bpmn:startEvent id="s_inicio" name=""><bpmn:outgoing>f13</bpmn:outgoing></bpmn:startEvent><bpmn:task id="s_sensor" name="Avaliar última leitura do sensor"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_off" name="Sem leitura há mais de 30 min?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="manut" name="Abrir chamado de manutenção e usar só chuva"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:task><bpmn:businessRuleTask id="motor" name="Calcular nível (motor de risco)"><bpmn:incoming>f15</bpmn:incoming><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="g_inc" name="Dado incompleto e nível menor?"><bpmn:incoming>f18</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing><bpmn:outgoing>f20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="manter" name="Manter o nível anterior"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_cmp" name="Nível subiu?"><bpmn:incoming>f19</bpmn:incoming><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="g_igual" name="Nível igual?"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing><bpmn:outgoing>f25</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="g_chave" name="Chave de idempotência já usada?"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:outgoing>f27</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="descartar" name="Descartar e contar duplicado"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f32</bpmn:outgoing></bpmn:task><bpmn:task id="gravar" name="Gravar alerta e fila de envios"><bpmn:incoming>f26</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_alto" name="Nível Alerta ou maior?"><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing><bpmn:outgoing>f30</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="vistoria" name="Abrir chamado de vistoria"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:task><bpmn:task id="igual" name="Não reenviar (anti-spam)"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f33</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_obs" name="Caiu para Observação?"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f34</bpmn:outgoing><bpmn:outgoing>f35</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="encerrar" name="Gravar mensagem de encerramento"><bpmn:incoming>f34</bpmn:incoming><bpmn:outgoing>f36</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_fim" name=""><bpmn:incoming>f29</bpmn:incoming><bpmn:incoming>f31</bpmn:incoming><bpmn:incoming>f32</bpmn:incoming><bpmn:incoming>f33</bpmn:incoming><bpmn:incoming>f35</bpmn:incoming><bpmn:incoming>f36</bpmn:incoming><bpmn:outgoing>f37</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="estado" name="Atualizar estado do setor"><bpmn:incoming>f37</bpmn:incoming><bpmn:outgoing>f38</bpmn:outgoing></bpmn:task><bpmn:endEvent id="s_fim" name=""><bpmn:incoming>f38</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f13" name="" sourceRef="s_inicio" targetRef="s_sensor" /><bpmn:sequenceFlow id="f14" name="" sourceRef="s_sensor" targetRef="g_off" /><bpmn:sequenceFlow id="f15" name="não" sourceRef="g_off" targetRef="motor" /><bpmn:sequenceFlow id="f16" name="sim" sourceRef="g_off" targetRef="manut" /><bpmn:sequenceFlow id="f17" name="" sourceRef="manut" targetRef="motor" /><bpmn:sequenceFlow id="f18" name="" sourceRef="motor" targetRef="g_inc" /><bpmn:sequenceFlow id="f19" name="não" sourceRef="g_inc" targetRef="g_cmp" /><bpmn:sequenceFlow id="f20" name="sim" sourceRef="g_inc" targetRef="manter" /><bpmn:sequenceFlow id="f21" name="" sourceRef="manter" targetRef="g_cmp" /><bpmn:sequenceFlow id="f22" name="sim" sourceRef="g_cmp" targetRef="g_chave" /><bpmn:sequenceFlow id="f23" name="não" sourceRef="g_cmp" targetRef="g_igual" /><bpmn:sequenceFlow id="f24" name="sim" sourceRef="g_igual" targetRef="igual" /><bpmn:sequenceFlow id="f25" name="não: caiu" sourceRef="g_igual" targetRef="g_obs" /><bpmn:sequenceFlow id="f26" name="não" sourceRef="g_chave" targetRef="gravar" /><bpmn:sequenceFlow id="f27" name="sim" sourceRef="g_chave" targetRef="descartar" /><bpmn:sequenceFlow id="f28" name="" sourceRef="gravar" targetRef="g_alto" /><bpmn:sequenceFlow id="f29" name="não" sourceRef="g_alto" targetRef="g_fim" /><bpmn:sequenceFlow id="f30" name="sim" sourceRef="g_alto" targetRef="vistoria" /><bpmn:sequenceFlow id="f31" name="" sourceRef="vistoria" targetRef="g_fim" /><bpmn:sequenceFlow id="f32" name="" sourceRef="descartar" targetRef="g_fim" /><bpmn:sequenceFlow id="f33" name="" sourceRef="igual" targetRef="g_fim" /><bpmn:sequenceFlow id="f34" name="sim" sourceRef="g_obs" targetRef="encerrar" /><bpmn:sequenceFlow id="f35" name="não" sourceRef="g_obs" targetRef="g_fim" /><bpmn:sequenceFlow id="f36" name="" sourceRef="encerrar" targetRef="g_fim" /><bpmn:sequenceFlow id="f37" name="" sourceRef="g_fim" targetRef="estado" /><bpmn:sequenceFlow id="f38" name="" sourceRef="estado" targetRef="s_fim" /></bpmn:subProcess><bpmn:task id="enviar" name="Enviar a cada morador, com limite por minuto"><bpmn:incoming>f40</bpmn:incoming><bpmn:outgoing>f41</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /></bpmn:task><bpmn:exclusiveGateway id="g_envio" name="Canal aceitou?"><bpmn:incoming>f41</bpmn:incoming><bpmn:outgoing>f42</bpmn:outgoing><bpmn:outgoing>f43</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="trocar" name="Após 3 falhas, trocar de canal"><bpmn:incoming>f43</bpmn:incoming><bpmn:outgoing>f44</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_canais" name="Algum canal aceitou?"><bpmn:incoming>f44</bpmn:incoming><bpmn:outgoing>f45</bpmn:outgoing><bpmn:outgoing>f46</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="fila" name="Manter na fila do próximo ciclo; após 3 ciclos, avisar operador"><bpmn:incoming>f45</bpmn:incoming><bpmn:outgoing>f47</bpmn:outgoing></bpmn:task><bpmn:task id="concluir" name="Atualizar status na tabela alertas"><bpmn:incoming>f42</bpmn:incoming><bpmn:incoming>f46</bpmn:incoming><bpmn:incoming>f47</bpmn:incoming><bpmn:outgoing>f48</bpmn:outgoing></bpmn:task><bpmn:task id="exportar" name="Gravar alertas.json para o MVP (escrita atômica)"><bpmn:incoming>f48</bpmn:incoming><bpmn:outgoing>f49</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="g_dia" name="Primeira execução do dia?"><bpmn:incoming>f49</bpmn:incoming><bpmn:outgoing>f50</bpmn:outgoing><bpmn:outgoing>f51</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="relatorio" name="Gerar relatório diário em PDF"><bpmn:incoming>f51</bpmn:incoming><bpmn:outgoing>f52</bpmn:outgoing></bpmn:task><bpmn:task id="soltar" name="Soltar a trava"><bpmn:incoming>f50</bpmn:incoming><bpmn:incoming>f52</bpmn:incoming><bpmn:outgoing>f53</bpmn:outgoing></bpmn:task><bpmn:task id="log" name="Gravar resumo da execução no log de auditoria"><bpmn:incoming>f53</bpmn:incoming><bpmn:outgoing>f54</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim" name="Fim do ciclo"><bpmn:incoming>f54</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" name="" sourceRef="inicio" targetRef="trava" /><bpmn:sequenceFlow id="f2" name="" sourceRef="trava" targetRef="ler" /><bpmn:sequenceFlow id="f3" name="" sourceRef="ler" targetRef="g_arq" /><bpmn:sequenceFlow id="f4" name="sim" sourceRef="g_arq" targetRef="validar" /><bpmn:sequenceFlow id="f5" name="não" sourceRef="g_arq" targetRef="quarentena" /><bpmn:sequenceFlow id="f6" name="" sourceRef="quarentena" targetRef="validar" /><bpmn:sequenceFlow id="f7" name="" sourceRef="validar" targetRef="hash" /><bpmn:sequenceFlow id="f8" name="" sourceRef="hash" targetRef="api" /><bpmn:sequenceFlow id="f9" name="" sourceRef="api" targetRef="g_api" /><bpmn:sequenceFlow id="f10" name="sim" sourceRef="g_api" targetRef="g_junta" /><bpmn:sequenceFlow id="f11" name="não" sourceRef="g_api" targetRef="cache" /><bpmn:sequenceFlow id="f12" name="" sourceRef="cache" targetRef="g_junta" /><bpmn:sequenceFlow id="f39" name="" sourceRef="g_junta" targetRef="Setores" /><bpmn:sequenceFlow id="f40" name="" sourceRef="Setores" targetRef="enviar" /><bpmn:sequenceFlow id="f41" name="" sourceRef="enviar" targetRef="g_envio" /><bpmn:sequenceFlow id="f42" name="sim" sourceRef="g_envio" targetRef="concluir" /><bpmn:sequenceFlow id="f43" name="não" sourceRef="g_envio" targetRef="trocar" /><bpmn:sequenceFlow id="f44" name="" sourceRef="trocar" targetRef="g_canais" /><bpmn:sequenceFlow id="f45" name="não" sourceRef="g_canais" targetRef="fila" /><bpmn:sequenceFlow id="f46" name="sim" sourceRef="g_canais" targetRef="concluir" /><bpmn:sequenceFlow id="f47" name="" sourceRef="fila" targetRef="concluir" /><bpmn:sequenceFlow id="f48" name="" sourceRef="concluir" targetRef="exportar" /><bpmn:sequenceFlow id="f49" name="" sourceRef="exportar" targetRef="g_dia" /><bpmn:sequenceFlow id="f50" name="não" sourceRef="g_dia" targetRef="soltar" /><bpmn:sequenceFlow id="f51" name="sim" sourceRef="g_dia" targetRef="relatorio" /><bpmn:sequenceFlow id="f52" name="" sourceRef="relatorio" targetRef="soltar" /><bpmn:sequenceFlow id="f53" name="" sourceRef="soltar" targetRef="log" /><bpmn:sequenceFlow id="f54" name="" sourceRef="log" targetRef="fim" /></bpmn:process>
